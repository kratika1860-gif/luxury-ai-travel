# .env.local — copy this to .env.local and fill in your values

# ── Database (PostgreSQL via Supabase / Neon / Railway) ──────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/traviq?sslmode=require"

# ── NextAuth ─────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-here"   # openssl rand -base64 32

# OAuth providers (add whichever you want)
GOOGLE_CLIENT_ID="..."
GOOGLE_CLIENT_SECRET="..."

# ── Anthropic (for AI recommendations) ──────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-..."

# ── Exchange Rates API (https://exchangeratesapi.io  — free tier ok) ────
EXCHANGE_RATES_API_KEY="..."
EXCHANGE_RATES_BASE_URL="https://api.exchangeratesapi.io/v1"

# ── Optional: Amadeus Flight Data (https://developers.amadeus.com) ──────
# Used for real flight price trends. Falls back to AI estimation if absent.
AMADEUS_CLIENT_ID="..."
AMADEUS_CLIENT_SECRET="..."
